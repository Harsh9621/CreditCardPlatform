**/target/
**/.mvn/timing.properties
*.class

# Node / Vite
**/node_modules/
**/dist/
**/.vite/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Local database / dumps
*.sql
*.sqlite
*.db
